{
  "name": "backend",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "type": "module",
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "scripts": {
    "build": "tsdown",
    "composer:deploy": "prisma deploy module.ts",
    "composer:dev": "prisma dev module.ts",
    "contract:emit": "prisma contract emit",
    "db:init": "prisma db init",
    "db:seed": "tsx src/prisma/seed.ts",
    "db:reset": "tsx src/prisma/reset.ts",
    "db:fresh": "pnpm run db:reset && pnpm run db:seed",
    "db:update": "prisma db update",
    "db:verify": "prisma db verify",
    "deploy": "pnpm run build && pnpm run composer:deploy",
    "dev": "nodemon --exec tsx src/index.ts",
    "dev:composer": "pnpm run build && pnpm run composer:dev",
    "migrate": "prisma db migrate",
    "migration:plan": "prisma migration plan",
    "migration:show": "prisma migration show",
    "migration:status": "prisma migration status",
    "start": "node dist/server.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@prisma/composer": "0.19.0",
    "@prisma/composer-prisma-cloud": "0.19.0",
    "@prisma/orm-postgres": "8.0.0-rc.10",
    "alchemy": "2.0.0-beta.74",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "nodemon": "^3.1.14",
    "socket.io": "^4.8.3",
    "temporal-polyfill": "^1.0.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.6.2",
    "@types/supertest": "^7.2.1",
    "prisma": "latest",
    "supertest": "^7.3.0",
    "tsdown": "^0.22.14",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  }
}
